{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__path=:path*"
    },
    {
      "source": "/dropbox-auth",
      "destination": "/index.html"
    }
  ]
}
